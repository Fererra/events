# Copy to .env and change the secrets before running `docker compose up`.

POSTGRES_USER=events
POSTGRES_PASSWORD=events
POSTGRES_DB=events

# Long random strings, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Host port for HTTPS (nginx)
HTTPS_PORT=443
LOG_LEVEL=info
